alias claude="claude --effort max"
alias cc="claude"
alias gs="git status"
alias gget="git pull"
alias gput="git push origin HEAD"
alias gcmt="git commit"
alias fuck="sudo killall -HUP mDNSResponder"
alias pod="kubectl exec -n marcel -it deploy/marcel-rails-app -- bash"
alias podc="kubectl exec -n marcel -it deploy/marcel-rails-app -- bash -lc 'set -a; source deployment/get_secrets.sh; set +a; exec bin/rails c'"
